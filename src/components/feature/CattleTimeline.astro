---
// In-article interactive herd-growth timeline. A stepped line of herd size
// over time; hover or slide along it to reveal which animal(s) joined at each
// dot. Rendered at build time to SVG; a small script wires the tooltip.
// Styles live in global.css (.cattle-tl*) because scoped styles are unreliable
// for components rendered inside MDX.
import { herdGrowth } from '../../data/cattleHerd';

const steps = herdGrowth();
const time = (iso: string) => new Date(`${iso}T00:00:00`).getTime();
const shortDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const monthTick = (d: Date) =>
  `${d.toLocaleDateString('en-US', { month: 'short' })} '${String(d.getFullYear()).slice(2)}`;

// Plot geometry (unitless; SVG scales to its container). Left pad leaves room
// for the y-axis labels; top pad keeps the topmost count clear.
const W = 690, H = 220;
const padL = 30, padR = 16, padT = 16, padB = 28;
const yMax = steps[steps.length - 1].count + 1;

const tMin = time(steps[0].date);
const tMax = time(steps[steps.length - 1].date);
const x = (t: number) => padL + ((t - tMin) / (tMax - tMin)) * (W - padL - padR);
const y = (count: number) => (H - padB) - (count / yMax) * (H - padB - padT);
const yBase = y(0);

// Y-axis ticks (head count) every few animals, up to the headroom max.
const yStep = 3;
const yTicks: number[] = [];
for (let v = 0; v <= yMax; v += yStep) yTicks.push(v);

const pts = steps.map((s) => ({ ...s, cx: x(time(s.date)), cy: y(s.count) }));

// Step-before path: hold the previous level, then jump up on each acquisition.
let d = `M ${pts[0].cx.toFixed(1)} ${yBase.toFixed(1)}`;
let prevY = yBase;
for (const p of pts) {
  d += ` L ${p.cx.toFixed(1)} ${prevY.toFixed(1)} L ${p.cx.toFixed(1)} ${p.cy.toFixed(1)}`;
  prevY = p.cy;
}
const areaD = `${d} L ${pts[pts.length - 1].cx.toFixed(1)} ${yBase.toFixed(1)} Z`;

// Month ticks at real month boundaries, dropped when they'd collide (which is
// what made the clustered founding weeks overlap before).
const rawTicks = [{ cx: x(tMin), label: monthTick(new Date(tMin)) }];
let cur = new Date(new Date(tMin).getFullYear(), new Date(tMin).getMonth() + 1, 1);
while (cur.getTime() <= tMax) {
  rawTicks.push({ cx: x(cur.getTime()), label: monthTick(cur) });
  cur = new Date(cur.getFullYear(), cur.getMonth() + 1, 1);
}
const ticks: { cx: number; label: string }[] = [];
let lastX = -Infinity;
for (const t of rawTicks) {
  if (t.cx - lastX < 46) continue;
  ticks.push(t);
  lastX = t.cx;
}

const latest = pts[pts.length - 1];
const birth = pts.find((p) => p.born);
---

<figure class="cattle-tl">
  <div class="cattle-tl__head">
    <span class="cattle-tl__title">Herd growth</span>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} class="cattle-tl__svg" role="img"
       aria-label={`Herd growth: from ${pts[0].count} to ${latest.count} head between ${monthTick(new Date(tMin))} and ${monthTick(new Date(tMax))}. Interactive dots reveal each acquisition; the open dot is the calf born into the herd.`}>
    {yTicks.map((v) => (
      <line x1={padL} y1={y(v)} x2={W - padR} y2={y(v)} class={v === 0 ? 'cattle-tl__axis' : 'cattle-tl__grid'} />
    ))}
    {yTicks.map((v) => (
      <text x={padL - 8} y={y(v) + 3.5} text-anchor="end" class="cattle-tl__ylab">{v}</text>
    ))}
    <line x1={padL} y1={y(yMax)} x2={padL} y2={yBase} class="cattle-tl__axis" />
    <path d={areaD} class="cattle-tl__area" />
    <path d={d} class="cattle-tl__line" />
    {ticks.map((t) => (
      <text x={t.cx} y={H - 9} text-anchor="middle" class="cattle-tl__tick">{t.label}</text>
    ))}
    {pts.map((p) => (
      <circle cx={p.cx} cy={p.cy} r={p.born ? 5 : 3.5}
        class={p.born ? 'cattle-tl__dot cattle-tl__dot--birth' : 'cattle-tl__dot'} />
    ))}
    {birth && (
      <g>
        <line x1={birth.cx - 5} y1={birth.cy - 5} x2={birth.cx - 18} y2={birth.cy - 18} class="cattle-tl__annot-line" />
        <text x={birth.cx - 22} y={birth.cy - 15} text-anchor="end" class="cattle-tl__annot-text">first calf</text>
      </g>
    )}
    {/* Enlarged transparent hit targets: keyboard-focusable, drive the tooltip. */}
    {pts.map((p) => (
      <circle cx={p.cx} cy={p.cy} r="15" class="cattle-tl__hit" tabindex="0" role="button"
        data-date={shortDate(p.date)}
        data-names={p.added.join(' · ')}
        data-count={String(p.count)}
        aria-label={`${shortDate(p.date)}: ${p.added.join(', ')} ${p.born ? 'born into the herd' : 'joined'}. Herd now ${p.count}.`} />
    ))}
  </svg>

  <div class="cattle-tl__tip" hidden>
    <span class="cattle-tl__tip-date"></span>
    <span class="cattle-tl__tip-names"></span>
    <span class="cattle-tl__tip-herd"></span>
  </div>
</figure>

<script>
  function setupTimeline(fig: HTMLElement) {
    if (fig.dataset.ready) return;
    fig.dataset.ready = '1';
    const svg = fig.querySelector('svg')!;
    const tip = fig.querySelector<HTMLElement>('.cattle-tl__tip')!;
    const tipDate = tip.querySelector<HTMLElement>('.cattle-tl__tip-date')!;
    const tipNames = tip.querySelector<HTMLElement>('.cattle-tl__tip-names')!;
    const tipHerd = tip.querySelector<HTMLElement>('.cattle-tl__tip-herd')!;
    const hits = Array.from(fig.querySelectorAll<SVGCircleElement>('.cattle-tl__hit'));
    const dots = Array.from(fig.querySelectorAll<SVGCircleElement>('.cattle-tl__dot'));

    function show(i: number) {
      const hit = hits[i];
      dots.forEach((dot, j) => dot.classList.toggle('is-active', j === i));
      hits.forEach((h, j) => h.classList.toggle('is-active', j === i));
      tipDate.textContent = hit.dataset.date ?? '';
      tipNames.textContent = hit.dataset.names ?? '';
      tipHerd.textContent = `Herd → ${hit.dataset.count}`;
      tip.hidden = false;

      const r = hit.getBoundingClientRect();
      const fr = fig.getBoundingClientRect();
      const tipW = tip.offsetWidth;
      let left = r.left - fr.left + r.width / 2;
      left = Math.max(tipW / 2 + 4, Math.min(left, fig.clientWidth - tipW / 2 - 4));
      tip.style.left = `${left}px`;
      tip.style.top = `${r.top - fr.top}px`;
    }

    function hide() {
      tip.hidden = true;
      dots.forEach((dot) => dot.classList.remove('is-active'));
      hits.forEach((h) => h.classList.remove('is-active'));
    }

    hits.forEach((hit, i) => {
      hit.addEventListener('pointerenter', () => show(i));
      hit.addEventListener('focus', () => show(i));
      hit.addEventListener('blur', hide);
    });

    // Slide anywhere across the plot: snap the tooltip to the nearest dot.
    svg.addEventListener('pointermove', (e) => {
      let best = -1, bestDist = Infinity;
      hits.forEach((hit, i) => {
        const r = hit.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - e.clientX);
        if (dist < bestDist) { bestDist = dist; best = i; }
      });
      if (best >= 0 && bestDist < 70) show(best);
    });
    fig.addEventListener('pointerleave', hide);
  }

  function initTimelines() {
    document.querySelectorAll<HTMLElement>('.cattle-tl').forEach(setupTimeline);
  }

  document.addEventListener('astro:page-load', initTimelines);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimelines);
  } else {
    initTimelines();
  }
</script>

