---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { imageSize } from 'image-size';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { funCoverGradient } from '../../data/site';

const items = (await getCollection('personal')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Precompute intrinsic dimensions for any real cover images (local files only).
const cards = items.map((it) => {
  let width: number | undefined;
  let height: number | undefined;
  if (it.data.cover && it.data.cover.startsWith('/')) {
    try {
      const dims = imageSize(readFileSync(path.join(process.cwd(), 'public', it.data.cover)));
      width = dims.width;
      height = dims.height;
    } catch {
      // missing file: fall back to the gradient placeholder
    }
  }
  return { entry: it, width, height };
});
---

<Layout
  title="Odds and Ends — JD Pruett"
  description="Time well spent, perhaps better spent elsewhere."
>
  <main class="wrap funpage">
    <section class="subhero subhero--sm">
      <h1>Odds and Ends</h1>
      <p>Time well spent, though perhaps better spent elsewhere.</p>
    </section>

    <ul class="funfeed">
      {cards.map(({ entry, width, height }) => (
        <li>
          <a class="funcard" href={`/personal/${entry.id}/`}>
            {entry.data.cover
              ? (
                <img
                  class="funcard__cover"
                  src={entry.data.cover}
                  alt={entry.data.title}
                  width={width}
                  height={height}
                  loading="lazy"
                />
              ) : (
                <span
                  class="funcard__cover funcard__cover--ph"
                  style={`background:${funCoverGradient(entry.data.tint)}`}
                  aria-hidden="true"
                ></span>
              )}
            <h2 class="funcard__title">{entry.data.title}</h2>
            <p class="funcard__desc">{entry.data.dek ?? entry.data.summary}</p>
            <span class="funcard__meta">
              <span class="funcard__tag">{entry.data.status}</span>
              <span class="funcard__go">View <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
