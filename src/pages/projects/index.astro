---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// The project index: one editorial row per feature, ordered like the sidebar in
// ProjectFeature.astro. This is a real, indexable page — /projects/ used to be a
// platform redirect to the lowest-order project.
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = 'Projects — JD Pruett';
const description =
  'Long-form write-ups of JD Pruett’s research and engineering work across AI, neuroscience, and survey methods.';

// CollectionPage + ItemList describe exactly what is visible: the ordered list
// of project features and where each one links.
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL('/projects/', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/projects/${p.id}/`, Astro.site).href,
      name: p.data.title,
    })),
  },
};
---

<Layout title={title} description={description} jsonLd={collectionLd}>
  <main class="wrap projpage">
    <section class="subhero subhero--sm">
      <h1>Projects</h1>
      <p>Research and engineering — long-form write-ups of selected work.</p>
    </section>

    <ol class="projindex">
      {projects.map((p, i) => (
        <li class="projindex__item">
          <a class="projindex__link" href={`/projects/${p.id}/`}>
            <span class="projindex__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="projindex__body">
              <span class="projindex__head">
                <h2 class="projindex__title">{p.data.title}</h2>
                <span class="projindex__meta">
                  {p.data.kind}{p.data.date && <>&nbsp;·&nbsp;{p.data.date}</>}
                </span>
              </span>
              <span class="projindex__summary">{p.data.summary}</span>
            </span>
            <span class="projindex__go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Layout>

<style>
  .projpage { padding-bottom: 96px; }

  .projindex {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .projindex__item {
    border-top: 1px solid var(--rule);
  }
  .projindex__item:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .projindex__link {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 24px;
    gap: clamp(14px, 2.4vw, 28px);
    align-items: baseline;
    padding: clamp(22px, 3vw, 32px) 6px clamp(22px, 3vw, 32px) 16px;
  }
  /* Blue edge marker that fills on hover — the same cue as the feature sidebar. */
  .projindex__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--blue);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.1, 1);
  }
  .projindex__item:hover::before,
  .projindex__item:focus-within::before {
    transform: scaleY(1);
  }

  .projindex__num {
    font-style: italic;
    font-size: 15px;
    color: var(--ink-faint);
    transition: color 0.25s ease;
  }

  .projindex__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .projindex__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .projindex__title {
    font-size: clamp(21px, 2.6vw, 27px);
    font-weight: 460;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--ink-soft);
    margin: 0;
    transition: color 0.25s ease;
  }
  .projindex__meta {
    font-style: italic;
    font-size: 14px;
    color: var(--ink-faint);
  }
  .projindex__summary {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0;
  }

  .projindex__go {
    align-self: center;
    justify-self: end;
    font-size: 18px;
    color: var(--ink-faint);
    transform: translateX(-4px);
    opacity: 0;
    transition: transform 0.25s var(--ease), opacity 0.25s ease, color 0.25s ease;
  }

  .projindex__link:hover .projindex__title,
  .projindex__link:focus-visible .projindex__title { color: var(--ink); }
  .projindex__link:hover .projindex__num,
  .projindex__link:focus-visible .projindex__num { color: var(--blue); }
  .projindex__link:hover .projindex__go,
  .projindex__link:focus-visible .projindex__go {
    opacity: 1;
    transform: translateX(0);
    color: var(--blue);
  }

  @media (max-width: 560px) {
    .projindex__link { grid-template-columns: 30px minmax(0, 1fr); }
    .projindex__go { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .projindex__item::before,
    .projindex__go { transition: none; }
  }
</style>
